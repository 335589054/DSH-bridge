{
  "name": "dsh-plugin-workbuddy",
  "version": "0.6.0",
  "type": "module",
  "private": false,
  "description": "把 WorkBuddy 订阅模型接入 DeepSeek Harness：本地 bridge + llm-pi-ai 手写网关路由 + 抓包/环境管理面板",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "llm"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./route": "./lib/route.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "models.json",
    "install.mjs",
    "sync-models.mjs",
    "locale/*.json",
    "icon.svg",
    "bridge",
    "README.md",
    "INSTALL.md",
    "GUIDE.md"
  ],
  "scripts": {
    "build": "node sync-models.mjs --offline",
    "sync-models": "node sync-models.mjs",
    "install:dsh": "node install.mjs",
    "uninstall:dsh": "node install.mjs --uninstall"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
